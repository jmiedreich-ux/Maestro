#!/usr/bin/env python3
"""Start one Maestro agent in a root-supervised constrained systemd unit."""

from __future__ import annotations

import hashlib
import ipaddress
import os
import pwd
import socket
import stat
import subprocess
import sys
import tomllib
from pathlib import Path

CONFIG = Path("@CONFIG_FILE@")
PROFILE_ROOT = Path("@DATA_DIR@")
RUN_ROOT = Path("/run/maestro/agent-egress")
SYSTEMD_RUN = "/usr/bin/systemd-run"
BWRAP = "/usr/bin/bwrap"
RUNNER = "/usr/local/libexec/maestro-agent-egress-run"
SERVICE_USER = "@SERVICE_USER@"
PROFILE_FILES = {
    Path(".codex/auth.json"),
    Path(".claude.json"),
    Path(".claude/.credentials.json"),
}
CALLER_FD_OPTIONS = frozenset(
    {
        "--args",
        "--userns",
        "--userns2",
        "--pidns",
        "--sync-fd",
        "--bind-fd",
        "--ro-bind-fd",
        "--file",
        "--bind-data",
        "--ro-bind-data",
        "--seccomp",
        "--add-seccomp-fd",
        "--block-fd",
        "--userns-block-fd",
        "--info-fd",
        "--json-status-fd",
    }
)


def fail(message: str) -> None:
    print(f"maestro agent egress: {message}", file=sys.stderr)
    raise SystemExit(64)


def valid_run_id(value: str) -> bool:
    return bool(value) and all(character.isalnum() or character in "-_" for character in value)


def load_configuration() -> dict[str, object]:
    try:
        with CONFIG.open("rb") as stream:
            configuration = tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot load the service configuration: {error}")
    if not isinstance(configuration, dict):
        fail("service configuration is invalid")
    return configuration


def load_destinations(configuration: dict[str, object], route: str) -> list[tuple[str, int]]:
    try:
        tools = configuration["tools"]
        values = tools[route]["permitted_destinations"]
    except (KeyError, TypeError) as error:
        fail(f"cannot load the configured route: {error}")
    if not isinstance(values, list) or not values:
        fail("configured route has no permitted destinations")
    result: list[tuple[str, int]] = []
    for value in values:
        if not isinstance(value, dict):
            fail("configured destination is invalid")
        host, port = value.get("hostname"), value.get("port")
        if not isinstance(host, str) or not host or host != host.lower() or not isinstance(port, int):
            fail("configured destination is invalid")
        if not 1 <= port <= 65535:
            fail("configured destination is invalid")
        result.append((host, port))
    return result


def load_agent_account(configuration: dict[str, object]) -> pwd.struct_passwd:
    try:
        value = configuration["service"]["agent_user"]
    except (KeyError, TypeError) as error:
        fail(f"cannot load the configured agent account: {error}")
    if not isinstance(value, str) or not value or value == SERVICE_USER:
        fail("configured agent account is invalid")
    try:
        account = pwd.getpwnam(value)
    except KeyError:
        fail("configured agent account does not exist")
    if account.pw_uid == 0:
        fail("configured agent account is invalid")
    return account


def resolve(destinations: list[tuple[str, int]]) -> tuple[list[str], list[tuple[list[str], int]]]:
    hosts = ["127.0.0.1 localhost", "::1 localhost"]
    result: list[tuple[list[str], int]] = []
    for host, port in destinations:
        try:
            entries = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except socket.gaierror as error:
            fail(f"cannot resolve {host}: {error}")
        addresses = sorted({entry[4][0] for entry in entries})
        if not addresses:
            fail(f"cannot resolve {host}")
        hosts.append(f"{' '.join(addresses)} {host}")
        result.append((addresses, port))
    return hosts, result


def write_hosts(run_id: str, lines: list[str]) -> Path:
    RUN_ROOT.mkdir(parents=True, mode=0o711, exist_ok=True)
    os.chmod(RUN_ROOT.parent, 0o711)
    os.chmod(RUN_ROOT, 0o711)
    directory = RUN_ROOT / run_id
    directory.mkdir(mode=0o711, exist_ok=False)
    os.chmod(directory, 0o711)
    hosts = directory / "hosts"
    descriptor = os.open(hosts, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o444)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write("\n".join(lines) + "\n")
    return hosts


def unit_name(run_id: str) -> str:
    return f"maestro-agent-{run_id}"


def outer_command(route: str, run_id: str, bwrap_arguments: list[str]) -> list[str]:
    if route not in {"codex", "claude_code"} or not valid_run_id(run_id):
        fail("route or run identifier is invalid")
    if not bwrap_arguments or bwrap_arguments[0] != BWRAP or "--" not in bwrap_arguments:
        fail("isolated command is invalid")
    configuration = load_configuration()
    # Fail before creating any runtime state when the configured identity is unsafe.
    load_agent_account(configuration)
    hosts, resolved = resolve(load_destinations(configuration, route))
    hosts_path = write_hosts(run_id, hosts)
    split = bwrap_arguments.index("--")
    sandbox = bwrap_arguments[:split] + ["--ro-bind", str(hosts_path), "/etc/hosts"] + bwrap_arguments[split:]
    arguments = [SYSTEMD_RUN, "--pipe", "--wait", "--collect", f"--unit={unit_name(run_id)}", "--property=IPAddressDeny=any", "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK"]
    for addresses, _ in resolved:
        for address in addresses:
            suffix = "/128" if ipaddress.ip_address(address).version == 6 else "/32"
            arguments.append(f"--property=IPAddressAllow={address}{suffix}")
    return arguments + [RUNNER, unit_name(run_id), str(hosts_path), *[f"{address}:{port}" for addresses, port in resolved for address in addresses], "--", *sandbox]


def run_outer() -> None:
    if os.geteuid() != 0 or len(sys.argv) < 5:
        fail("must run as root with route, run identifier, and isolated command")
    process = subprocess.run(outer_command(sys.argv[1], sys.argv[2], sys.argv[3:]), check=False)
    raise SystemExit(process.returncode)


def rule_table(unit: str) -> str:
    return "maestro_egress_" + hashlib.sha256(unit.encode("utf-8")).hexdigest()[:16]


def nft_apply(table: str, unit: str, pairs: list[tuple[str, int]]) -> None:
    grouped: dict[tuple[int, int], list[str]] = {}
    for address, port in pairs:
        grouped.setdefault((ipaddress.ip_address(address).version, port), []).append(address)
    rules = [f"table inet {table} {{", " chain output {", "  type filter hook output priority filter; policy accept;"]
    match = f'socket cgroupv2 level 2 "system.slice/{unit}.service"'
    for (version, port), addresses in sorted(grouped.items()):
        family = "ip6" if version == 6 else "ip"
        rules.append(f"  {match} {family} daddr {{ {', '.join(sorted(addresses))} }} tcp dport {port} accept")
    rules.append(f"  {match} drop")
    rules.extend([" }", "}"])
    subprocess.run(["/usr/sbin/nft", "-f", "-"], input="\n".join(rules) + "\n", text=True, check=True)


def nft_remove(table: str) -> None:
    subprocess.run(["/usr/sbin/nft", "delete", "table", "inet", table], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _profile_target_is_safe(relative: Path, target: Path) -> bool:
    """Profiles are exposed only below the isolated run's private scratch home."""
    if not target.is_absolute() or ".." in target.parts:
        return False
    expected = ("scratch", "home", *relative.parts)
    return len(target.parts) >= len(expected) and target.parts[-len(expected) :] == expected


def _open_profile(source: Path) -> int:
    """Open one approved credential without following service-controlled links."""
    try:
        relative = source.relative_to(PROFILE_ROOT)
    except ValueError:
        fail("credential profile is outside the supported profile root")
    if relative not in PROFILE_FILES:
        fail("credential profile is unsupported")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    directory_flags = flags | os.O_DIRECTORY
    descriptor = os.open(PROFILE_ROOT, directory_flags)
    try:
        for component in relative.parts[:-1]:
            next_descriptor = os.open(component, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
        credential = os.open(relative.name, flags, dir_fd=descriptor)
    finally:
        os.close(descriptor)
    metadata = os.fstat(credential)
    try:
        service = pwd.getpwnam(SERVICE_USER)
    except KeyError:
        os.close(credential)
        fail("installed service account does not exist")
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != service.pw_uid:
        os.close(credential)
        fail("credential profile is unsafe")
    return credential


def profile_data_mounts(sandbox: list[str]) -> tuple[list[str], tuple[int, ...]]:
    """Replace only approved profile binds with descriptor-backed read-only mounts."""
    rewritten: list[str] = []
    descriptors: list[int] = []
    index = 0
    try:
        while index < len(sandbox):
            value = sandbox[index]
            if value == "--":
                rewritten.extend(sandbox[index:])
                break
            if value in CALLER_FD_OPTIONS:
                fail("isolated command cannot consume inherited descriptors")
            if value == "--ro-bind" and index + 2 < len(sandbox):
                source = Path(sandbox[index + 1])
                target = Path(sandbox[index + 2])
                if source.is_relative_to(PROFILE_ROOT):
                    relative = source.relative_to(PROFILE_ROOT)
                    if relative in PROFILE_FILES:
                        if not _profile_target_is_safe(relative, target):
                            fail("credential profile target is invalid")
                        descriptor = _open_profile(source)
                        descriptors.append(descriptor)
                        rewritten.extend(("--ro-bind-data", str(descriptor), str(target)))
                    else:
                        rewritten.extend((value, str(source), str(target)))
                else:
                    rewritten.extend((value, str(source), str(target)))
                index += 3
                continue
            rewritten.append(value)
            index += 1
        return rewritten, tuple(descriptors)
    except BaseException:
        for descriptor in descriptors:
            os.close(descriptor)
        raise


def sandbox_as_agent(sandbox: list[str], account: pwd.struct_passwd) -> list[str]:
    try:
        separator = sandbox.index("--")
    except ValueError:
        fail("invalid isolated command")
    # These are appended last so a caller cannot override the guarded child identity.
    return sandbox[:separator] + ["--uid", str(account.pw_uid), "--gid", str(account.pw_gid)] + sandbox[separator:]


def run_inner() -> None:
    if os.geteuid() != 0 or len(sys.argv) < 6 or "--" not in sys.argv:
        fail("invalid root-supervised launch")
    unit, hosts = sys.argv[1], Path(sys.argv[2])
    if not unit.startswith("maestro-agent-") or not hosts.is_file():
        fail("invalid root-supervised launch")
    separator = sys.argv.index("--")
    try:
        pairs = [(value.rsplit(":", 1)[0], int(value.rsplit(":", 1)[1])) for value in sys.argv[3:separator]]
        for address, port in pairs:
            ipaddress.ip_address(address)
            if not 1 <= port <= 65535:
                raise ValueError
    except ValueError:
        fail("invalid resolved destination")
    sandbox = sys.argv[separator + 1 :]
    if not sandbox or sandbox[0] != BWRAP:
        fail("invalid isolated command")
    table = rule_table(unit)
    configuration = load_configuration()
    account = load_agent_account(configuration)
    sandbox, profile_descriptors = profile_data_mounts(sandbox)
    try:
        sandbox = sandbox_as_agent(sandbox, account)
        nft_apply(table, unit, pairs)
        def demote() -> None:
            os.initgroups(account.pw_name, account.pw_gid)
            os.setgid(account.pw_gid)
            os.setuid(account.pw_uid)
        process = subprocess.run(
            sandbox,
            check=False,
            preexec_fn=demote,
            pass_fds=profile_descriptors,
        )
        raise SystemExit(process.returncode)
    finally:
        for descriptor in profile_descriptors:
            os.close(descriptor)
        nft_remove(table)


if __name__ == "__main__":
    if Path(sys.argv[0]).name == "maestro-agent-egress-run":
        run_inner()
    run_outer()
